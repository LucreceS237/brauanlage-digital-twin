# ---------------------------------------------------------------------------
# Brauanlage Digital Twin MVP - environment example
# Copy to .env and adjust as needed. docker-compose reads these via the
# service "environment" blocks; this file documents the available knobs.
# ---------------------------------------------------------------------------

# MongoDB connection (inside the compose network the host is "mongodb")
MONGODB_URI=mongodb://mongodb:27017/brewing_digital_twin
MONGODB_DB_NAME=brewing_digital_twin

# MQTT broker (real-SPS data path: mqtt_publisher -> mosquitto -> backend).
# Inside Docker, ALWAYS use the service name "mosquitto" (never localhost).
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_TOPIC=brauanlage/sps/live

# OPC-UA endpoint of the real SPS/PLC. Read ONLY by the mqtt_publisher, which
# reads the SPS and republishes over MQTT. Adapt to the real SPS IP later.
OPCUA_SERVER_URL=opc.tcp://192.168.0.10:4840

# Allow simulation mode as a presentation fallback.
ENABLE_SIMULATION_MODE=true

# How long the backend waits for the first valid MQTT SPS payload on connect.
SPS_MESSAGE_TIMEOUT_SECONDS=10

# Seconds between collector processing cycles.
COLLECTOR_INTERVAL_SECONDS=1

# Shared process simulator (backend simulation + mqtt fake publisher)
SIMULATION_TOTAL_DURATION_SECONDS=1800
SIMULATION_TICK_SECONDS=1
SIMULATION_SPEED_FACTOR=1
SIMULATION_SCENARIO=NORMAL_PROCESS

# CORS origins allowed to call the backend ("*" for the demo).
CORS_ORIGINS=*

# Frontend -> backend base URL (used by the browser).
VITE_API_BASE_URL=http://localhost:8000

# --- mqtt_publisher specific -----------------------------------------------
# Publisher mode: FAKE_PUBLISHER (ProcessSimulator) or REAL_SPS (OPC-UA).
PUBLISHER_MODE=FAKE_PUBLISHER
